{
  "schema_version": 6,
  "kind": "feature",
  "scope": {
    "allowed_paths": [
      "desktop/plugin.js",
      "tests/plugin.test.mjs",
      "README.md"
    ]
  },
  "test_scope": {
    "allowed_paths": [
      "tests/plugin.test.mjs"
    ]
  },
  "development_method": "strict_sdd_tdd_v2",
  "specification": {
    "objective": "Allow moving sessions between tag columns and persistently reordering columns.",
    "requirements": [
      {
        "id": "REQ-MOVE-1",
        "statement": "Users can drag a tagged session to another tag column and the session assignment and color update persistently."
      },
      {
        "id": "REQ-MOVE-2",
        "statement": "Users can reorder tag columns and their order persists through reload; accessible non-drag controls are available."
      }
    ],
    "acceptance_criteria": [
      {
        "id": "AC-MOVE-1",
        "statement": "Dropping a valid session onto a tag column changes its tag and color while other sessions remain unchanged; keyboard-accessible controls allow the same operation.",
        "requirements": [
          "REQ-MOVE-1"
        ],
        "proof": "regression"
      },
      {
        "id": "AC-MOVE-2",
        "statement": "Dragging and accessible controls reorder tag columns and restored preferences preserve the order; new or deleted tags remain valid.",
        "requirements": [
          "REQ-MOVE-2"
        ],
        "proof": "regression"
      }
    ],
    "invariants": [
      {
        "id": "INV-MOVE-1",
        "statement": "Existing profile filters, navigation, tag settings and other session assignments remain intact."
      }
    ],
    "forbidden_states": [
      {
        "id": "FORBID-MOVE-1",
        "statement": "Unrelated or invalid drag payloads mutate assignments or tag order."
      }
    ],
    "inputs": [
      {
        "id": "INPUT-MOVE-1",
        "statement": "Drag or accessible move action and persisted tag preferences."
      }
    ],
    "outputs": [
      {
        "id": "OUTPUT-MOVE-1",
        "statement": "Updated tag assignment or persistent tag column ordering."
      }
    ],
    "failure_semantics": [
      {
        "id": "FAIL-MOVE-1",
        "statement": "Invalid, stale or cancelled drag interactions do not mutate preferences."
      }
    ]
  },
  "baseline_lock": {
