{
  "schema_version": 6,
  "kind": "feature",
  "scope": {
    "allowed_paths": [
      "desktop/plugin.js",
      "tests/plugin.test.mjs",
      "README.md"
    ]
  },
  "test_scope": {
    "allowed_paths": [
      "tests/plugin.test.mjs"
    ]
  },
  "development_method": "strict_sdd_tdd_v2",
  "specification": {
    "objective": "Display tagged sessions in a kanban-style board grouped by tag.",
    "requirements": [
      {
        "id": "REQ-BOARD-1",
        "statement": "Organize tagged sessions in accessible columns by tag across profile routes, including unavailable assignments."
      }
    ],
    "acceptance_criteria": [
      {
        "id": "AC-BOARD-1",
        "statement": "Each tag column contains its matching sessions from all profiles and unavailable assignments, with a tag label, count and profile context.",
        "requirements": [
          "REQ-BOARD-1"
        ],
        "proof": "regression"
      },
      {
        "id": "AC-BOARD-2",
        "statement": "Existing profile and tag filters, search, session opening, and feedback remain functional.",
        "requirements": [
          "REQ-BOARD-1"
        ],
        "proof": "regression"
      }
    ],
    "invariants": [
      {
        "id": "INV-BOARD-1",
        "statement": "Viewing the board does not modify tags, assignments or sessions."
      }
    ],
    "forbidden_states": [
      {
        "id": "FORBID-BOARD-1",
        "statement": "A session appears under a different tag or its profile route is lost."
      }
    ],
    "inputs": [
      {
        "id": "INPUT-BOARD-1",
        "statement": "Tag assignments and profile session listings."
      }
    ],
    "outputs": [
      {
        "id": "OUTPUT-BOARD-1",
        "statement": "An accessible horizontally scrollable board of tag columns and session cards."
      }
    ],
    "failure_semantics": [
      {
        "id": "FAIL-BOARD-1",
        "statement": "Unavailable session details and profile loading errors remain visible."
      }
    ]
  },
